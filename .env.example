# ANWESHAN — Environment Configuration
# Copy to .env and fill in your values.

# ── Backend (Python/Flask) ──
FLASK_APP=backend/app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret
DATABASE_URL=sqlite:///anweshan.db

# Twilio (SMS/Voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# JWT
JWT_SECRET=anweshan-dev-secret-key-change-in-production

# ── Frontend (React/Vite) ──
VITE_API_URL=http://localhost:5000
